@page "/"
@inject BlazorPortal.Services.OrderApiService ApiService
@inject BlazorPortal.Services.CartState Cart
@inject NavigationManager Nav
@rendermode InteractiveServer

<h2>🛍️ Products</h2>

@if (_products == null)
{
    <p>Loading products...</p>
}
else if (!_products.Any())
{
    <p>No products available.</p>
}
else
{
    <div style="display:flex; flex-wrap:wrap; gap:16px;">
        @foreach (var product in _products)
        {
            <div style="border:1px solid #ccc; padding:16px; width:220px; border-radius:8px;">
                <h4>@product.Name</h4>
                <p>@product.Description</p>
                <p><strong>€@product.Price</strong></p>
                <p>Category: @product.Category</p>
                <button @onclick="() => AddToCart(product)">
                    Add to Cart 🛒
                </button>
            </div>
        }
    </div>
}

@if (_addedMessage != null)
{
    <p style="color:green; margin-top:12px;">@_addedMessage</p>
}

@code {
    private List<BlazorPortal.Services.ProductDto>? _products;
    private string? _addedMessage;

    protected override async Task OnInitializedAsync()
    {
        _products = await ApiService.GetProductsAsync();
    }

    private void AddToCart(BlazorPortal.Services.ProductDto product)
    {
        Cart.AddItem(product);
        _addedMessage = $"✅ {product.Name} added to cart!";
        StateHasChanged();
    }
}