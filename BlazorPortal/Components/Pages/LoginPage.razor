@page "/login"
@inject BlazorPortal.Services.AuthService AuthService
@inject NavigationManager Nav
@rendermode InteractiveServer

<div style="max-width:420px; margin:60px auto; padding:20px;">
    <div style="background:white; border-radius:16px;
                box-shadow:0 4px 20px rgba(0,0,0,0.1); padding:40px;">

        <div style="text-align:center; margin-bottom:30px;">
            <span style="font-size:48px;">🏆</span>
            <h2 style="color:#1a1a2e; margin:8px 0;">
                SPORT<span style="color:#e94560;">STORE</span>
            </h2>
            <p style="color:gray;">Sign in to your account</p>
        </div>

        @* Tab Switch *@
        <div style="display:flex; margin-bottom:24px; border-radius:8px;
                    overflow:hidden; border:2px solid #1a1a2e;">
            <button @onclick='() => _isLogin = true'
                    style="flex:1; padding:10px; border:none;
                           background:@(_isLogin ? "#1a1a2e" : "white");
                           color:@(_isLogin ? "white" : "#1a1a2e");
                           font-weight:600; cursor:pointer;">
                Sign In
            </button>
            <button @onclick='() => _isLogin = false'
                    style="flex:1; padding:10px; border:none;
                           background:@(!_isLogin ? "#1a1a2e" : "white");
                           color:@(!_isLogin ? "white" : "#1a1a2e");
                           font-weight:600; cursor:pointer;">
                Register
            </button>
        </div>

        @if (_isLogin)
        {
            @* Login Form *@
            <input placeholder="Email address"
                   @bind="_email" type="email"
                   style="width:100%; padding:12px; margin-bottom:12px;
                              border-radius:8px; border:2px solid #e0e0e0;
                              font-size:15px;" />
            <input placeholder="Password"
                   @bind="_password" type="password"
                   style="width:100%; padding:12px; margin-bottom:20px;
                              border-radius:8px; border:2px solid #e0e0e0;
                              font-size:15px;" />
            <button @onclick="HandleLogin"
                    disabled="@_loading"
                    style="width:100%; padding:14px; background:#e94560;
                               color:white; border:none; border-radius:8px;
                               font-size:16px; font-weight:600; cursor:pointer;">
                @(_loading ? "Signing in..." : "Sign In →")
            </button>
        }
        else
        {
            @* Register Form *@
            <input placeholder="Full Name"
                   @bind="_fullName"
                   style="width:100%; padding:12px; margin-bottom:12px;
                              border-radius:8px; border:2px solid #e0e0e0;
                              font-size:15px;" />
            <input placeholder="Email address"
                   @bind="_email" type="email"
                   style="width:100%; padding:12px; margin-bottom:12px;
                              border-radius:8px; border:2px solid #e0e0e0;
                              font-size:15px;" />
            <input placeholder="Password (min 6 characters)"
                   @bind="_password" type="password"
                   style="width:100%; padding:12px; margin-bottom:20px;
                              border-radius:8px; border:2px solid #e0e0e0;
                              font-size:15px;" />
            <button @onclick="HandleRegister"
                    disabled="@_loading"
                    style="width:100%; padding:14px; background:#2ecc71;
                               color:white; border:none; border-radius:8px;
                               font-size:16px; font-weight:600; cursor:pointer;">
                @(_loading ? "Creating account..." : "Create Account →")
            </button>
        }

        @if (_error != null)
        {
            <p style="color:red; text-align:center; margin-top:12px;">
                ⚠️ @_error
            </p>
        }

        @* Admin hint *@
        <p style="text-align:center; color:gray; font-size:12px;
                  margin-top:20px;">
            Admin? Use admin@sportstore.com / Admin123!
        </p>
    </div>
</div>

@code {
    private bool _isLogin = true;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _fullName = string.Empty;
    private string? _error;
    private bool _loading = false;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(_email) ||
            string.IsNullOrWhiteSpace(_password))
        {
            _error = "Please fill in all fields.";
            return;
        }

        _loading = true;
        _error = null;

        var success = await AuthService.LoginAsync(_email, _password);
        if (success)
        {
            if (AuthService.IsAdmin)
                Nav.NavigateTo("/admin");
            else
                Nav.NavigateTo("/");
        }
        else
        {
            _error = "Invalid email or password.";
        }
        _loading = false;
    }

    private async Task HandleRegister()
    {
        if (string.IsNullOrWhiteSpace(_fullName) ||
            string.IsNullOrWhiteSpace(_email) ||
            string.IsNullOrWhiteSpace(_password))
        {
            _error = "Please fill in all fields.";
            return;
        }

        if (_password.Length < 6)
        {
            _error = "Password must be at least 6 characters.";
            return;
        }

        _loading = true;
        _error = null;

        var success = await AuthService.RegisterAsync(
            _fullName, _email, _password);
        if (success)
            Nav.NavigateTo("/");
        else
            _error = "Registration failed. Email may already be in use.";

        _loading = false;
    }
}