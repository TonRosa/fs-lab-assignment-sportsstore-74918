@page "/admin"
@inject BlazorPortal.Services.AuthService AuthService
@inject BlazorPortal.Services.OrderApiService ApiService
@inject NavigationManager Nav
@rendermode InteractiveServer

@if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
{
    <p>Redirecting to login...</p>
}
else
{
    <div style="max-width:1200px; margin:0 auto; padding:20px;">

        <div style="display:flex; justify-content:space-between;
                        align-items:center; margin-bottom:24px;">
            <h2>⚙️ Admin Panel</h2>
            <span style="color:gray;">
                👋 <strong>@AuthService.CurrentUser?.FullName</strong>
                (Admin)
            </span>
        </div>

        @* Tab Navigation *@
        <div style="display:flex; gap:8px; margin-bottom:24px;">
            <button @onclick='() => _tab = "orders"'
                    style="padding:10px 20px; border:none; border-radius:8px;
                               cursor:pointer; font-weight:600;
                               background:@(_tab == "orders" ? "#e94560" : "#1a1a2e");
                               color:white;">
                📦 Orders
            </button>
            <button @onclick='() => _tab = "products"'
                    style="padding:10px 20px; border:none; border-radius:8px;
                               cursor:pointer; font-weight:600;
                               background:@(_tab == "products" ? "#e94560" : "#1a1a2e");
                               color:white;">
                🏷️ Products
            </button>
        </div>

        @* Orders Tab *@
        @if (_tab == "orders")
        {
            <div style="background:white; border-radius:12px;
                                box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:20px;">
                <div style="display:flex; justify-content:space-between;
                                    margin-bottom:16px;">
                    <h3>Orders</h3>
                    <button @onclick="LoadOrders"
                            style="padding:8px 16px; background:#1a1a2e;
                                           color:white; border:none; border-radius:8px;
                                           cursor:pointer;">
                        🔄 Refresh
                    </button>
                </div>

                @if (_ordersLoading)
                {
                    <p>⏳ Loading...</p>
                }
                else if (!_orders.Any())
                {
                    <p style="color:gray;">No orders yet.</p>
                }
                else
                {
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="background:#f5f5f5;">
                                <th style="padding:10px; text-align:left;">ID</th>
                                <th style="padding:10px; text-align:left;">Customer</th>
                                <th style="padding:10px; text-align:left;">Status</th>
                                <th style="padding:10px; text-align:left;">Payment</th>
                                <th style="padding:10px; text-align:left;">Total</th>
                                <th style="padding:10px; text-align:left;">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in _orders)
                            {
                                <tr style="border-bottom:1px solid #eee;">
                                    <td style="padding:10px;">
                                        <strong>#@order.ShortId</strong>
                                    </td>
                                    <td style="padding:10px;">@order.CustomerName</td>
                                    <td style="padding:10px;">
                                        <span style="padding:3px 10px;
                                                                     border-radius:20px;
                                                                     color:white; font-size:12px;
                                                                     background:@GetStatusColor(order.Status);">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td style="padding:10px;">
                                        @if (order.PaymentRecord == null)
                                        {
                                            <span style="color:orange;">⏳</span>
                                        }
                                        else if (order.PaymentRecord.IsApproved)
                                        {
                                            <span style="color:green;">✅</span>
                                        }
                                        else
                                        {
                                            <span style="color:red;">❌</span>
                                        }
                                    </td>
                                    <td style="padding:10px;">€@order.TotalAmount</td>
                                    <td style="padding:10px; font-size:13px;">
                                        @order.CreatedAt.ToLocalTime()
                                        .ToString("dd MMM HH:mm")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }

        @* Products Tab *@
        @if (_tab == "products")
        {
            <div style="background:white; border-radius:12px;
                                box-shadow:0 2px 8px rgba(0,0,0,0.1); padding:20px;">
                <div style="display:flex; justify-content:space-between;
                                    margin-bottom:16px;">
                    <h3>Products</h3>
                    <button @onclick="ShowAddProduct"
                            style="padding:8px 16px; background:#2ecc71;
                                           color:white; border:none; border-radius:8px;
                                           cursor:pointer;">
                        + Add Product
                    </button>
                </div>

                @* Add/Edit Form *@
                @if (_showProductForm)
                {
                    <div style="background:#f9f9f9; padding:20px;
                                            border-radius:8px; margin-bottom:20px;
                                            border:2px solid #e0e0e0;">
                        <h4>@(_editingProduct == null ? "Add New Product" : "Edit Product")</h4>
                        <div style="display:grid; grid-template-columns:1fr 1fr;
                                                gap:12px; margin-top:12px;">
                            <input placeholder="Product Name"
                                   @bind="_form.Name"
                                   style="padding:10px; border-radius:8px;
                                                      border:2px solid #e0e0e0;" />
                            <input placeholder="Category"
                                   @bind="_form.Category"
                                   style="padding:10px; border-radius:8px;
                                                      border:2px solid #e0e0e0;" />
                            <input placeholder="Price (e.g. 29.99)"
                                   @bind="_form.Price" type="number"
                                   style="padding:10px; border-radius:8px;
                                                      border:2px solid #e0e0e0;" />
                            <input placeholder="Stock quantity"
                                   @bind="_form.Stock" type="number"
                                   style="padding:10px; border-radius:8px;
                                                      border:2px solid #e0e0e0;" />
                            <input placeholder="Description"
                                   @bind="_form.Description"
                                   style="padding:10px; border-radius:8px;
                                                      border:2px solid #e0e0e0;
                                                      grid-column:span 2;" />
                        </div>
                        @if (_formError != null)
                        {
                            <p style="color:red; margin-top:8px;">@_formError</p>
                        }
                        <div style="display:flex; gap:8px; margin-top:12px;">
                            <button @onclick="SaveProduct"
                                    style="padding:10px 20px; background:#e94560;
                                                       color:white; border:none;
                                                       border-radius:8px; cursor:pointer;">
                                💾 Save
                            </button>
                            <button @onclick="() => _showProductForm = false"
                                    style="padding:10px 20px; background:gray;
                                                       color:white; border:none;
                                                       border-radius:8px; cursor:pointer;">
                                Cancel
                            </button>
                        </div>
                    </div>
                }

                @* Products Table *@
                @if (_productsLoading)
                {
                    <p>⏳ Loading...</p>
                }
                else
                {
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="background:#f5f5f5;">
                                <th style="padding:10px; text-align:left;">Name</th>
                                <th style="padding:10px; text-align:left;">Category</th>
                                <th style="padding:10px; text-align:left;">Price</th>
                                <th style="padding:10px; text-align:left;">Stock</th>
                                <th style="padding:10px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in _products)
                            {
                                <tr style="border-bottom:1px solid #eee;">
                                    <td style="padding:10px;">@product.Name</td>
                                    <td style="padding:10px;">@product.Category</td>
                                    <td style="padding:10px;">€@product.Price</td>
                                    <td style="padding:10px;">
                                        <span style="color:@(product.Stock < 10 ? "orange" : "green");">
                                            @product.Stock
                                        </span>
                                    </td>
                                    <td style="padding:10px;">
                                        <button @onclick="() => EditProduct(product)"
                                                style="padding:6px 12px;
                                                                       background:#3498db;
                                                                       color:white; border:none;
                                                                       border-radius:6px;
                                                                       cursor:pointer;
                                                                       margin-right:4px;">
                                            ✏️ Edit
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
    </div>
}

@code {
    private string _tab = "orders";
    private List<BlazorPortal.Services.OrderDto> _orders = new();
    private List<BlazorPortal.Services.ProductDto> _products = new();
    private bool _ordersLoading = true;
    private bool _productsLoading = true;
    private bool _showProductForm = false;
    private BlazorPortal.Services.ProductDto? _editingProduct;
    private ProductFormModel _form = new();
    private string? _formError;

    // protected override async Task OnInitializedAsync()
    // {
    //     await AuthService.InitializeAsync();
    //     await Task.Delay(100); // small delay for session to load

    //     if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
    //     {
    //         Nav.NavigateTo("/login");
    //         return;
    //     }

    //     await LoadOrders();
    //     await LoadProducts();
    // }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AuthService.InitializeAsync();
            await Task.Delay(100);

            if (!AuthService.IsLoggedIn || !AuthService.IsAdmin)
            {
                Nav.NavigateTo("/login");
                return;
            }

            await LoadOrders();
            await LoadProducts();
            StateHasChanged();
        }
    }
    private async Task LoadOrders()
    {
        _ordersLoading = true;
        try
        {
            _orders = await ApiService.GetAllOrdersAsync();
        }
        catch { _orders = new(); }
        _ordersLoading = false;
    }

    private async Task LoadProducts()
    {
        _productsLoading = true;
        try
        {
            _products = await ApiService.GetProductsAsync();
        }
        catch { _products = new(); }
        _productsLoading = false;
    }

    private void ShowAddProduct()
    {
        _editingProduct = null;
        _form = new ProductFormModel();
        _showProductForm = true;
        _formError = null;
    }

    private void EditProduct(BlazorPortal.Services.ProductDto product)
    {
        _editingProduct = product;
        _form = new ProductFormModel
        {
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            Stock = product.Stock,
            Category = product.Category
        };
        _showProductForm = true;
        _formError = null;
    }

    private async Task SaveProduct()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) ||
            string.IsNullOrWhiteSpace(_form.Category))
        {
            _formError = "Name and category are required.";
            return;
        }

        try
        {
            if (_editingProduct == null)
                await ApiService.AddProductAsync(_form);
            else
                await ApiService.UpdateProductAsync(_editingProduct.Id, _form);

            _showProductForm = false;
            await LoadProducts();
        }
        catch (Exception ex)
        {
            _formError = $"Error: {ex.Message}";
        }
    }

    private string GetStatusColor(Shared.Contracts.Enums.OrderStatus status)
        => status switch
        {
            Shared.Contracts.Enums.OrderStatus.Completed => "#2ecc71",
            Shared.Contracts.Enums.OrderStatus.Failed => "#e74c3c",
            Shared.Contracts.Enums.OrderStatus.PaymentFailed => "#e74c3c",
            Shared.Contracts.Enums.OrderStatus.InventoryFailed => "#e74c3c",
            Shared.Contracts.Enums.OrderStatus.PaymentApproved => "#3498db",
            _ => "#f39c12"
        };

    public class ProductFormModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Stock { get; set; }
        public string Category { get; set; } = string.Empty;
    }
}